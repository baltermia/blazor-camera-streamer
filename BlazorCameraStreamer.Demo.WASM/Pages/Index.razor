@page "/"

<p>FrameCount: @frameCount</p>

<CameraStreamer @ref=CameraStreamerReference
                Width=1920
                Height=1080
                OnRendered=OnRenderedHandler
                OnFrame=OnFrameHandler
                Style="width: 480px; height: 270px;"
                CameraID=@cameraId
                FacingMode=CameraFacingMode.Environment
                Autostart />

<div>
    <button @onclick=Start>
        Start
    </button>
    <button @onclick=Stop>
        Stop
    </button>
</div>

<div>
    <select @onchange=OnCameraSelected>
        <option value="">Default (rear camera preferred)</option>
        @foreach (var camera in cameras)
        {
            <option value=@camera.DeviceId selected=@(camera.DeviceId == cameraId)>@GetCameraName(camera)</option>
        }
    </select>
</div>

<button  @onclick=GetCurrentFrame>
    Get Current Frame
</button>

<br />

@if (!string.IsNullOrEmpty(imageData))
{
    <img src=@imageData
         style="width: 480px; height: 270px; object-fit: contain;"/>
}

@code
{
    private CameraStreamer CameraStreamerReference;

    private string cameraId = null;

    private int frameCount;

    private string imageData;

    private MediaDeviceInfoModel[] cameras = [];

    private async Task OnRenderedHandler()
    {
        frameCount = 0;

        // Check camera-access or ask user, if it's not allowed currently
        if (await CameraStreamerReference.GetCameraAccessAsync())
        {
            // The names of the cameras are only available after the access is granted
            cameras = await CameraStreamerReference.GetCameraDevicesAsync();

            // Reloading re-initializes the stream and starts the
            // stream automatically if the Autostart parameter is set
            await CameraStreamerReference.ReloadAsync();

            // If Autostart is not set, you have to manually start the stream again
            /* await CameraStreamerReference.StartAsync(); */
        }
    }

    private async void Start()
    {
        await CameraStreamerReference.StartAsync();
    }

    private async void Stop()
    {
        await CameraStreamerReference.StopAsync();
    }

    private void OnFrameHandler(string _)
    {
        ++frameCount;
    }

    private async Task OnCameraSelected(ChangeEventArgs e)
    {
        // An empty value is the default camera, which the browser chooses based on the FacingMode
        cameraId = e.Value as string is { Length: > 0 } id ? id : null;

        await CameraStreamerReference.ChangeCameraAsync(cameraId);
    }

    private static string GetCameraName(MediaDeviceInfoModel camera)
    {
        string name = string.IsNullOrEmpty(camera.Label) ? "Unnamed camera" : camera.Label;

        // The facing mode is only known if the browser reports it (usually not for desktop webcams)
        return camera.FacingMode switch
        {
            CameraFacingMode.User => $"{name} (front)",
            CameraFacingMode.Environment => $"{name} (rear)",
            _ => name
        };
    }

    // Return a Task (not void) so the page re-renders after the frame is received
    private async Task GetCurrentFrame()
    {
        imageData = await CameraStreamerReference.GetCurrentFrameAsync();
    }
}
